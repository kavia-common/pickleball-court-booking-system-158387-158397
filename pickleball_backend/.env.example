# Copy to .env and set secure values for your environment

# Secret key for signing tokens; use a strong random value in production
SECRET_KEY=change-me-in-production

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Admin credentials for the built-in admin user (no registration endpoint)
# Either ADMIN_USERNAME or ADMIN_EMAIL may be used as the login username
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
